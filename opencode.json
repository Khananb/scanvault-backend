{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "daisyui": {
      "type": "local",
      "command": ["npx", "-y", "birdseyevue/daisyui-mcp"],
      "enabled": true
    },
    "figma": {
      "type": "local",
      "command": ["npx", "-y", "mcp-figma"],
      "enabled": true
    }
  }
}
